# 复制本文件为 .env，填入你自己的值（.env 已 gitignore，不要提交）
# OpenAI 兼容接口，换供应商只改下面三行

OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# embedding 模型（返回向量的模型；维度由程序首次调用时自动探测，无需手填）
EMBEDDING_MODEL=BAAI/bge-m3

# 生成模型（chat/completions）
CHAT_MODEL=deepseek-ai/DeepSeek-V3

# 可选：语料目录 / 数据目录 / 检索条数（均有默认值，一般不用改）
# CORPUS_DIR=./corpus
# DATA_DIR=./data
# TOP_K=4
